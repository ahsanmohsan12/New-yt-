# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash scriptwriting & TTS API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WORKER_SECRET_TOKEN: Shared authentication token used by external Google Colab Tesla T4 GPU workers
# when registering, sending heartbeats, and claiming atomic chapter tasks.
WORKER_SECRET_TOKEN="aivf-colab-worker-token-2026"
